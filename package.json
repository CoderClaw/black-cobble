{
  "name": "black-cobble",
  "version": "0.1.1",
  "private": true,
  "description": "Editor de notas Markdown y HTML con bovedas locales",
  "author": "",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "package:win": "npm run build && electron-builder --win portable",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "chokidar": "^4.0.3",
    "entities": "^8.1.0",
    "lucide-react": "^0.468.0",
    "parse5": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "local.blackcobble.editor",
    "productName": "Black Cobble",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/search-worker.cjs"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "black-cobble",
      "synopsis": "Editor de notas Markdown y HTML con bovedas locales",
      "description": "Editor de notas Markdown y HTML con bovedas locales",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    }
  }
}
